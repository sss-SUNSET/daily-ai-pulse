PORT=3000
SUMMARY_LANGUAGE=zh-CN

# LLM Provider: gemini, openai (supports DeepSeek, SiliconFlow, Zhipu, Ollama)
LLM_PROVIDER=openai

# Option A: Gemini configuration (requires international connection)
GEMINI_API_KEY=

# Option B: OpenAI-compatible configuration (recommended for domestic direct connection)
# SiliconFlow: https://api.siliconflow.cn/v1 | Model: deepseek-ai/DeepSeek-V3
# DeepSeek: https://api.deepseek.com/v1 | Model: deepseek-flash
# Zhipu AI: https://open.bigmodel.cn/api/paas/v4 | Model: glm-4-flash (free)
# Ollama: http://localhost:11434/v1 | Model: deepseek-r1:7b or qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3
ENABLE_THINKING=true
THINKING_EFFORT=medium

# SMTP Email Configuration
SMTP_HOST=smtp.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Receiver Email
RECEIVER_EMAIL=xuhongtaooo@outlook.com
